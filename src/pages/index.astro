---
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/home/Hero.astro";
import Weekly from "../components/home/Weekly.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import Features from "../components/home/Features.astro";
import Explore from "../components/home/Explore.astro";
import Faq from "../components/home/Faq.astro";
import DownloadCta from "../components/DownloadCta.astro";
import { faq } from "../data/faq";
import { appNode, faqNode } from "../lib/seo";
---

<PageLayout jsonLd={[appNode(), faqNode("/", faq)]}>
  <Hero />
  <Weekly />
  <HowItWorks />
  <Features />
  <Explore />
  <Faq />
  <DownloadCta />
</PageLayout>
