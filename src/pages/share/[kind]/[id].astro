---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { site } from "../../../data/site";
import { sharePage } from "../../../lib/share";
import { shareService } from "../../../lib/share-service";
import shareRedirectScript from "../../../scripts/share-redirect.js?raw";

export const prerender = false;

const page = await sharePage(shareService, Astro.params.kind, Astro.params.id);
Astro.response.status = page.status;
Astro.response.headers.set("Cache-Control", page.cacheControl);
if (page.status === 503) Astro.response.headers.set("Retry-After", "30");
---

<BaseLayout
  title={page.title}
  description={page.description}
  image={page.urls?.image}
  imageAlt={page.metadata?.title}
  canonicalPath={page.urls?.canonical}
  noindex={page.status !== 200}
>
  <main aria-labelledby="share-title">
    {
      page.urls ? (
        <>
          <h1 id="share-title">들리에서 듣기</h1>
          <p>앱이나 스토어가 열리지 않으면 아래 링크를 눌러 주세요.</p>
          <nav
            aria-label="앱 열기 및 다운로드"
            data-share-redirect
            data-app-store={site.stores.appStore}
            data-google-play={site.stores.googlePlay}
          >
            <a href={page.urls.app}>들리 앱 열기</a>
            <a href={site.stores.appStore}>App Store</a>
            <a href={site.stores.googlePlay}>Google Play</a>
          </nav>
          <script
            is:inline
            data-share-redirect-script
            set:html={shareRedirectScript}
          />
        </>
      ) : (
        <>
          <h1 id="share-title">{page.title.replace(" | 들리", "")}</h1>
          <p>{page.description}</p>
          <nav aria-label="오류 페이지 이동">
            {page.status === 503 && (
              <a href={Astro.url.pathname}>다시 시도하기</a>
            )}
            <a href="/">들리 홈으로</a>
          </nav>
        </>
      )
    }
  </main>
</BaseLayout>

<style>
  main {
    max-width: 32rem;
    margin-inline: auto;
    padding: 2rem 1.25rem;
  }
  h1 {
    font-size: 1.25rem;
    font-weight: 700;
  }
  p {
    margin-block: 0.75rem;
    color: var(--color-fg-muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-brand);
    text-decoration: underline;
  }
</style>
