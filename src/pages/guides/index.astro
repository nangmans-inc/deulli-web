---
import PageLayout from "../../layouts/PageLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DownloadCta from "../../components/DownloadCta.astro";
import GuideList from "../../components/GuideList.astro";
import { getGuides, guidePath } from "../../lib/content";
import { breadcrumbNode, itemListNode, webPageNode } from "../../lib/seo";

const title = "영어 학습 가이드";
const description =
  "팟캐스트로 영어를 공부하는 순서, 영어공부를 시작하는 방법, 학습 앱 고르는 기준을 들리가 썼습니다.";
const path = "/guides/";
const crumbs = [
  { name: "들리 홈", path: "/" },
  { name: "학습 가이드", path },
];
const guides = await getGuides();
---

<PageLayout
  title={`${title} | 들리`}
  description={description}
  canonicalPath={path}
  jsonLd={[
    webPageNode({ path, title, description, type: "CollectionPage" }),
    breadcrumbNode(crumbs),
    itemListNode(
      title,
      guides.map((guide) => ({
        name: guide.data.title,
        path: guidePath(guide.id),
      })),
    ),
  ]}
>
  <div class="container-content">
    <div class="hub">
      <Breadcrumbs crumbs={crumbs} />
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <GuideList headingLevel="h2" />
    </div>
  </div>
  <DownloadCta />
</PageLayout>

<style>
  .hub {
    max-width: 46rem;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem);
  }
  h1 {
    margin-top: 1.5rem;
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .lead {
    margin-block: 1rem 2.5rem;
    color: var(--color-fg-muted);
    font-size: var(--text-lead);
    line-height: 1.8;
  }
</style>
