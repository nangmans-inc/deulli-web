---
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getGuides, guidePath } from "../../lib/content";

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<ArticleLayout
  title={guide.data.title}
  description={guide.data.description}
  path={guidePath(guide.id)}
  parents={[{ name: "학습 가이드", path: "/guides/" }]}
  publishedAt={guide.data.publishedAt}
  updatedAt={guide.data.updatedAt}
  currentGuide={guide.id}
>
  <Content />
</ArticleLayout>
