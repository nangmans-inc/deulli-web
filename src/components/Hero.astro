---
import { Image } from "astro:assets";
import SignupForm from "./SignupForm.astro";
import Multiline from "./ui/Multiline.astro";
import { prelaunch } from "../data/prelaunch";
import { site } from "../data/site";
import appPlayer from "../assets/app-player.png";
import mascot from "../assets/mascot.png";
---

<section class="hero" data-ga-section="prelaunch">
  <div class="hero-inner container-content">
    <div class="copy">
      <Image
        class="mascot reveal"
        src={mascot}
        alt=""
        widths={[112, 224, 336]}
        sizes="(min-width: 1024px) 112px, 84px"
        loading="eager"
      />

      <p class="badge reveal" style="--reveal-delay: 60ms;">
        <span class="badge-dot" aria-hidden="true"></span>
        {prelaunch.badge}
      </p>

      <h1 class="reveal" style="--reveal-delay: 100ms;">
        <Multiline text={prelaunch.heading} />
        <span class="brandword">{prelaunch.headingBrand}</span>
      </h1>

      <p class="lead reveal" style="--reveal-delay: 140ms;">{prelaunch.lead}</p>

      <div class="form reveal" style="--reveal-delay: 180ms;">
        <SignupForm />
      </div>
    </div>

    <div
      class="visual reveal"
      style="--reveal-delay: 220ms;"
      aria-hidden="true"
    >
      <div class="phone">
        <Image
          src={appPlayer}
          alt=""
          widths={[300, 460, 680, 906]}
          sizes="(min-width: 1024px) 340px, (min-width: 640px) 300px, 272px"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <footer class="foot container-content">
    <nav aria-label="사이트 정보">
      <a
        href={`mailto:${site.email}`}
        data-ga-event="mailto_click"
        data-ga-label="footer">문의</a
      >
      <span aria-hidden="true">·</span>
      <a href={site.policy.privacy} target="_blank" rel="noopener"
        >개인정보 처리방침</a
      >
      <span aria-hidden="true">·</span>
      <a href={site.policy.terms} target="_blank" rel="noopener">이용약관</a>
    </nav>
    <p>© {new Date().getFullYear()} {site.nameKo} · {site.legalName}</p>
  </footer>
</section>

<style>
  /* 아이보리 바탕 · 네이비 슬로건 · 브랜드 블루 강조.
     Figma의 Feature Graphic v2("안 들리면, 들리.")와 같은 조합이다. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-ivory);
    color: var(--color-fg);
    padding-block: 2rem 1.25rem;
  }

  /* 평면 아이보리에 빛을 한 겹 얹는다. 위는 밝게, 오른쪽 아래는 브랜드 블루가 옅게 번진다. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        52rem 34rem at 8% -14%,
        rgba(255, 255, 255, 0.55),
        transparent 62%
      ),
      radial-gradient(
        46rem 38rem at 94% 108%,
        rgba(1, 80, 229, 0.1),
        transparent 62%
      );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    flex: 1;
    display: grid;
    align-items: center;
    gap: 2rem;
  }

  /* ── 카피 ─────────────────────────────────────────────── */
  .mascot {
    width: 5.25rem;
    height: 5.25rem;
    margin-bottom: 0.75rem;
    filter: drop-shadow(0 14px 26px rgba(8, 33, 66, 0.22));
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    padding: 0.32rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-on-brand);
  }
  .badge-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-ivory);
    animation: badge-pulse 2.4s var(--ease-out-soft) infinite;
  }
  @keyframes badge-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-dot {
      animation: none;
    }
  }

  h1 {
    margin: 0.85rem 0 0;
    font-size: var(--text-display);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--color-neutral-900);
  }
  .brandword {
    display: block;
    margin-top: 0.1em;
    /* 슬로건을 받는 브랜드명이라 한 단계 크고 브랜드 블루다 */
    font-size: 1.32em;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-brand);
  }

  .lead {
    margin: 1rem 0 0;
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .form {
    margin-top: 1.5rem;
    max-width: 26rem;
  }

  /* ── 목업 ─────────────────────────────────────────────── */
  .visual {
    display: flex;
    justify-content: center;
  }
  .phone {
    position: relative;
    width: 17rem;
    /* 아래쪽을 잘라 배경으로 흘려보낸다. 전체를 다 보여주면 세로가 너무 길고,
       하단 재생 컨트롤은 여기서 팔 것이 아니다 — 팔 것은 문장이 짚이는 화면이다. */
    max-height: clamp(19rem, 40vh, 24rem);
    overflow: hidden;
    mask-image: linear-gradient(180deg, #000 68%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 68%, transparent 100%);
  }
  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.75rem;
    box-shadow: 0 44px 80px -34px rgba(8, 33, 66, 0.55);
  }

  /* ── 푸터 ─────────────────────────────────────────────── */
  .foot {
    position: relative;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-fg-faint);
  }
  .foot nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem 0.75rem;
  }
  .foot a {
    color: var(--color-fg-subtle);
    text-decoration: none;
    transition: color 0.18s;
  }
  .foot a:hover {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .foot p {
    margin: 0;
  }

  /* ── 640px 이상 ───────────────────────────────────────── */
  @media (min-width: 640px) {
    .phone {
      width: 18.75rem;
      max-height: clamp(20rem, 44vh, 27rem);
    }
  }

  /* ── 데스크톱 ─────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .hero {
      padding-block: 3rem 2rem;
    }
    .hero-inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 3rem;
    }
    .mascot {
      width: 7rem;
      height: 7rem;
    }
    .visual {
      justify-content: flex-end;
    }
    .phone {
      width: 21.25rem;
      max-height: min(29rem, 58vh);
      /* 정면이 아니라 살짝 기울인다. 스토어 아트의 각도를 그대로 가져왔다. */
      transform: rotate(-6deg);
    }
    .foot {
      flex-direction: row;
      justify-content: space-between;
      margin-top: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone {
      transform: none;
    }
  }
</style>
