---
import { Image } from "astro:assets";
import StoreLinks from "./StoreLinks.astro";
import Multiline from "./ui/Multiline.astro";
import { site } from "../data/site";
import heroMockup from "../assets/hero-mockup.png";
---

<section class="hero" data-ga-section="home">
  <header class="masthead container-content reveal">
    <div class="brand">
      <img
        class="appicon"
        src="/logo.svg"
        alt=""
        width="32"
        height="32"
        loading="eager"
      />
      <span class="wordmark">{site.nameKo}</span>
    </div>
  </header>

  <div class="container-content grid">
    <div class="copy">
      <div class="headline">
        <h1 class="reveal" style="--reveal-delay: 100ms;">
          <span class="heading-desktop"
            ><Multiline text={site.hero.heading} /></span
          >
          <span class="heading-mobile">듣다보면 들리니까</span>
          <span class="brandword">{site.nameKo}</span>
        </h1>
      </div>

      <p class="lead reveal" style="--reveal-delay: 140ms;">{site.hero.lead}</p>

      <div class="downloads reveal" style="--reveal-delay: 180ms;">
        <StoreLinks />
      </div>
    </div>

    <div class="shot reveal" style="--reveal-delay: 220ms;">
      <div class="shot-inner">
        <Image
          class="mockup"
          src={heroMockup}
          alt="들리 앱 재생 화면: 영어 문장과 한국어 번역, 재생 컨트롤"
          widths={[300, 450, 600, 900]}
          sizes="(min-width: 1024px) 380px, (min-width: 700px) 272px, min(62vw, 240px)"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <footer class="foot container-content">
    <p>© {new Date().getFullYear()} Deulli. All Rights Reserved.</p>
  </footer>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-block: 0 1.25rem;
    /* 배경은 여기서 칠하지 않는다. index.astro의 백드롭이 <main> 바닥에 깔려 있고,
       히어로가 면을 덮으면 그게 가려진다. overflow도 걸지 않는다 — 블롭을 자르는
       일은 백드롭 쪽이 맡는다. */
  }

  /* 위 패딩은 섹션이 아니라 헤더가 갖는다. 섹션에 주면 헤더가 화면 위에서 그만큼
     떠 버려 머리글이 아니라 떠다니는 요소로 보인다. */
  .masthead {
    position: relative;
    padding-block: 1.25rem 0;
  }

  .grid {
    position: relative;
    flex: 1;
    display: grid;
    align-content: center;
    gap: 2.5rem;
    padding-block: 2rem;
  }

  /* ── 카피 ─────────────────────────────────────────────── */
  .copy {
    max-width: 34rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .appicon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
  }
  .wordmark {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-neutral-900);
  }

  .headline {
    position: relative;
  }

  .heading-mobile {
    display: none;
  }

  h1 {
    margin: 0;
    font-size: var(--text-display);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--color-neutral-900);
  }
  .brandword {
    display: block;
    margin-top: 0.08em;
    /* 슬로건을 받는 브랜드명이라 한 단계 크고 브랜드 블루다 */
    font-size: 1.3em;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-brand);
  }

  .lead {
    margin: 1rem 0 0;
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .downloads {
    max-width: 27rem;
    margin-top: 1.75rem;
  }

  /* ── 목업 ─────────────────────────────────────────────── */
  .shot-inner {
    position: relative;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
  }
  .shot-inner :global(.mockup) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── 푸터 ─────────────────────────────────────────────── */
  /* 작은 저작권 문구도 옅은 배경 위에서 읽히도록 본문 보조색을 쓴다. */
  .foot {
    position: relative;
    margin-top: 2rem;
    font-size: 0.75rem;
    color: var(--color-fg-muted);
  }
  .foot p {
    margin: 0;
  }

  /* ── 1단 화면 ─────────────────────────────────────────── */
  /* svh는 모바일 주소창이 열린 상태를 기준으로 한다.
     텍스트와 버튼의 공간을 확보하고 남은 높이에 목업 전체를 맞춘다. */
  @media (max-width: 699px) {
    /* 1단에서는 컨테이너를 내용 폭까지 좁혀 가운데 둔다. 72rem 그대로 두면
       600~699px 구간에서 내용이 왼쪽에 붙고 오른쪽만 100px 넘게 빈다.
       36.5rem = 내용 34rem + 좌우 여백 2.5rem. */
    .masthead,
    .grid,
    .foot {
      max-width: 36.5rem;
    }
    .grid {
      flex: none;
      height: calc(100svh - 3.25rem);
      min-height: 0;
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      align-items: center;
      justify-items: center;
      gap: clamp(0.5rem, 1.5svh, 1rem);
      padding-block: clamp(0.5rem, 2svh, 1.25rem)
        max(1rem, env(safe-area-inset-bottom));
    }
    .copy {
      display: contents;
    }
    .headline,
    .lead {
      justify-self: start;
      text-align: left;
    }
    .heading-desktop {
      display: none;
    }
    .heading-mobile {
      display: inline;
    }
    h1 {
      font-size: clamp(1.125rem, min(6.5vw, 4.4svh), 2.25rem);
      line-height: 1.15;
    }
    .brandword {
      display: inline;
      margin: 0 0 0 0.2em;
      font-size: 1em;
      line-height: inherit;
    }
    .lead {
      margin: 0;
      font-size: clamp(0.875rem, min(4vw, 2.5svh), 1.125rem);
    }
    .downloads {
      order: 1;
      width: 100%;
      margin: 0;
    }
    .shot {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      min-height: 0;
    }
    .downloads :global(.store-links) {
      justify-content: center;
      gap: 0.5rem;
    }
    .downloads :global(.store-link img) {
      height: clamp(2.5rem, 11vw, 3rem);
    }
    .downloads :global(.store-link--google-play img) {
      height: clamp(3.2552rem, 14.3229vw, 3.90625rem);
    }
    .shot-inner {
      max-width: min(62vw, 15rem);
      height: 85%;
    }
    .shot-inner :global(.mockup) {
      height: 100%;
      object-fit: contain;
    }
    .foot {
      margin-top: 1.5rem;
      text-align: center;
    }
  }

  /* 작은 가로 화면은 카피와 목업을 나란히 놓고 다운로드를 아래에 둔다. */
  @media (max-width: 699px) and (max-height: 450px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr auto auto;
      column-gap: 1rem;
    }
    .headline {
      align-self: end;
    }
    .shot {
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .downloads {
      grid-column: 1 / -1;
    }
  }

  /* ── 2단 전환 ─────────────────────────────────────────── */
  /* dionomy는 1024px에서 갈랐는데, 그 사이 폭에서 카피는 왼쪽에 몰리고 오른쪽이
     통째로 비어 버린다. 700px부터 가른다 — 그 아래는 한 손 폭이라 1단이 자연스럽고,
     위로는 목업이 오른쪽을 채운다. */
  @media (min-width: 700px) {
    .hero {
      padding-block: 0 1.5rem;
    }
    .masthead {
      padding-block: 1.5rem 0;
    }
    .grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: 2.5rem;
    }
    .appicon {
      width: 2.25rem;
      height: 2.25rem;
    }
    .wordmark {
      font-size: 1.2rem;
    }
    .shot-inner {
      max-width: 17rem;
      margin-inline: auto 0;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      gap: 3.5rem;
    }
    .shot-inner {
      /* 세로가 짧은 화면(예: 1024×768)에서는 목업 높이가 화면을 넘겨 스크롤이 생긴다.
         목업 비율이 1:1.67이라 높이를 뷰포트에 묶어 두면 폭이 알아서 줄어든다. */
      max-width: min(23.75rem, 45vh);
    }
  }

  @media (min-width: 700px) and (max-height: 600px) {
    .grid {
      padding-block: 1rem;
      gap: 1.5rem;
    }
    h1 {
      font-size: clamp(1.5rem, 7svh, 2.5rem);
    }
    .lead,
    .downloads {
      margin-top: 0.75rem;
    }
    .shot-inner {
      max-width: min(17rem, 36svh);
    }
    .foot {
      margin-top: 0;
    }
  }
</style>
