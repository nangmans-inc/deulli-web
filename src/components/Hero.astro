---
import { Image } from "astro:assets";
import StoreLinks from "./StoreLinks.astro";
import Multiline from "./ui/Multiline.astro";
import { site } from "../data/site";
import heroMockup from "../assets/hero-mockup.png";
import mascot from "../assets/mascot.png";
---

<section class="hero" data-ga-section="home">
  <header class="masthead container-content reveal">
    <div class="brand">
      <img
        class="appicon"
        src="/logo.svg"
        alt=""
        width="32"
        height="32"
        loading="eager"
      />
      <span class="wordmark">{site.nameKo}</span>
    </div>
  </header>

  <div class="container-content grid">
    <div class="copy">
      {
        /* 목업이 없는 1단 화면에서 슬로건 오른쪽이 비어 허전하다. 그 자리에만 세운다. */
      }
      <div class="headline">
        <h1 class="reveal" style="--reveal-delay: 100ms;">
          <Multiline text={site.hero.heading} />
          <span class="brandword">{site.nameKo}</span>
        </h1>
        <Image
          class="buddy reveal"
          style="--reveal-delay: 160ms;"
          src={mascot}
          alt=""
          widths={[160, 320, 520]}
          sizes="160px"
          loading="eager"
        />
      </div>

      <p class="lead reveal" style="--reveal-delay: 140ms;">{site.hero.lead}</p>

      <div class="downloads reveal" style="--reveal-delay: 180ms;">
        <StoreLinks />
      </div>
    </div>

    <div class="shot reveal" style="--reveal-delay: 220ms;">
      <div class="shot-inner">
        <Image
          class="mockup"
          src={heroMockup}
          alt="들리 앱 재생 화면: 영어 문장과 한국어 번역, 재생 컨트롤"
          widths={[300, 450, 600, 900]}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 300px, 240px"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <footer class="foot container-content">
    <p>© {new Date().getFullYear()} Deulli. All Rights Reserved.</p>
  </footer>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-block: 0 1.25rem;
    /* 배경은 여기서 칠하지 않는다. index.astro의 백드롭이 <main> 바닥에 깔려 있고,
       히어로가 면을 덮으면 그게 가려진다. overflow도 걸지 않는다 — 블롭을 자르는
       일은 백드롭 쪽이 맡는다. */
  }

  /* 위 패딩은 섹션이 아니라 헤더가 갖는다. 섹션에 주면 헤더가 화면 위에서 그만큼
     떠 버려 머리글이 아니라 떠다니는 요소로 보인다. */
  .masthead {
    position: relative;
    padding-block: 1.25rem 0;
  }

  .grid {
    position: relative;
    flex: 1;
    display: grid;
    align-content: center;
    gap: 2.5rem;
    padding-block: 2rem;
  }

  /* ── 카피 ─────────────────────────────────────────────── */
  .copy {
    max-width: 34rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .appicon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
  }
  .wordmark {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-neutral-900);
  }

  .headline {
    position: relative;
  }

  /* 2단(목업이 보이는 폭)에서는 쓰지 않는다 */
  .headline :global(.buddy) {
    display: none;
  }

  h1 {
    margin: 0;
    font-size: var(--text-display);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--color-neutral-900);
  }
  .brandword {
    display: block;
    margin-top: 0.08em;
    /* 슬로건을 받는 브랜드명이라 한 단계 크고 브랜드 블루다 */
    font-size: 1.3em;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-brand);
  }

  .lead {
    margin: 1rem 0 0;
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .downloads {
    max-width: 27rem;
    margin-top: 1.75rem;
  }

  /* ── 목업 ─────────────────────────────────────────────── */
  .shot-inner {
    position: relative;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
  }
  .shot-inner :global(.mockup) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── 푸터 ─────────────────────────────────────────────── */
  /* 작은 저작권 문구도 옅은 배경 위에서 읽히도록 본문 보조색을 쓴다. */
  .foot {
    position: relative;
    margin-top: 2rem;
    font-size: 0.75rem;
    color: var(--color-fg-muted);
  }
  .foot p {
    margin: 0;
  }

  /* ── 1단 화면 ─────────────────────────────────────────── */
  /* 모바일은 마스코트로 제품을 보여주고 다운로드 버튼을 첫 화면에 둔다.
     본문을 헤더와 같은 왼쪽 축에 맞춘다. */
  @media (max-width: 699px) {
    .shot {
      display: none;
    }
    /* 1단에서는 컨테이너를 내용 폭까지 좁혀 가운데 둔다. 72rem 그대로 두면
       600~699px 구간에서 내용이 왼쪽에 붙고 오른쪽만 100px 넘게 빈다.
       36.5rem = 내용 34rem + 좌우 여백 2.5rem. */
    .masthead,
    .grid,
    .foot {
      max-width: 36.5rem;
    }
    .grid {
      padding-block: 1rem;
    }
    /* 슬로건 세 줄 기준 오른쪽 · 세로 가운데.
       크기를 vw에 비례시켜 어느 폭에서도 글자와 겹치지 않는다. */
    .headline :global(.buddy) {
      display: block;
      position: absolute;
      right: 0;
      top: 50%;
      translate: 0 -50%;
      width: min(30vw, 8.5rem);
      height: auto;
      filter: drop-shadow(0 12px 22px rgba(8, 33, 66, 0.22));
    }
  }

  /* ── 640px 이상 (아직 1단) ────────────────────────────── */
  @media (min-width: 640px) {
    .shot-inner {
      max-width: 18.75rem;
    }
  }

  /* 세로가 짧은 1단 화면(구형 소형 기기)에서만 리듬을 조인다. 일반 폰에는
     영향이 없다. */
  @media (max-width: 699px) and (max-height: 700px) {
    .grid {
      padding-block: 0.5rem;
    }
    .lead {
      margin-top: 0.75rem;
    }
    .downloads {
      margin-top: 1.25rem;
    }
  }

  /* ── 2단 전환 ─────────────────────────────────────────── */
  /* dionomy는 1024px에서 갈랐는데, 그 사이 폭에서 카피는 왼쪽에 몰리고 오른쪽이
     통째로 비어 버린다. 700px부터 가른다 — 그 아래는 한 손 폭이라 1단이 자연스럽고,
     위로는 목업이 오른쪽을 채운다. */
  @media (min-width: 700px) {
    .hero {
      padding-block: 0 1.5rem;
    }
    .masthead {
      padding-block: 1.5rem 0;
    }
    .grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: 2.5rem;
    }
    .appicon {
      width: 2.25rem;
      height: 2.25rem;
    }
    .wordmark {
      font-size: 1.2rem;
    }
    .shot-inner {
      max-width: 17rem;
      margin-inline: auto 0;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      gap: 3.5rem;
    }
    .shot-inner {
      /* 세로가 짧은 화면(예: 1024×768)에서는 목업 높이가 화면을 넘겨 스크롤이 생긴다.
         목업 비율이 1:1.67이라 높이를 뷰포트에 묶어 두면 폭이 알아서 줄어든다. */
      max-width: min(23.75rem, 45vh);
    }
  }
</style>
