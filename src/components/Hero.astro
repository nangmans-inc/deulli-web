---
import { Image } from "astro:assets";
import SignupForm from "./SignupForm.astro";
import Multiline from "./ui/Multiline.astro";
import { prelaunch } from "../data/prelaunch";
import { site } from "../data/site";
import heroMockup from "../assets/hero-mockup.png";
---

{
  /* 왼쪽 카피 · 오른쪽 목업 · 신청 폼은 카피 아래.
    dionomy-landing의 히어로 구성을 따르되 모바일을 제대로 잡았다 — 그쪽은
    목업이 먼저 오도록 order를 뒤집어서, 좁은 화면에서 슬로건보다 사진이 앞선다. */
}
<section class="hero" data-ga-section="prelaunch">
  <div class="glow" aria-hidden="true"></div>

  <div class="container-content grid">
    <div class="copy">
      <header class="brand reveal">
        <img
          class="appicon"
          src="/logo.svg"
          alt=""
          width="32"
          height="32"
          loading="eager"
        />
        <span class="wordmark">{site.nameKo}</span>
      </header>

      <p class="badge reveal" style="--reveal-delay: 60ms;">
        <span class="badge-dot" aria-hidden="true"></span>
        {prelaunch.badge}
      </p>

      <h1 class="reveal" style="--reveal-delay: 100ms;">
        <Multiline text={prelaunch.heading} />
        <span class="brandword">{prelaunch.headingBrand}</span>
      </h1>

      <p class="lead reveal" style="--reveal-delay: 140ms;">{prelaunch.lead}</p>

      <div class="form reveal" style="--reveal-delay: 180ms;">
        <SignupForm />
      </div>
    </div>

    <div class="shot reveal" style="--reveal-delay: 220ms;">
      <div class="shot-inner">
        <Image
          class="mockup"
          src={heroMockup}
          alt="들리 앱 재생 화면 — 지금 나오는 문장이 영어와 한국어로 함께 보인다"
          widths={[300, 450, 600, 900]}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 300px, 240px"
          loading="eager"
        />
      </div>
    </div>
  </div>

  <footer class="foot container-content">
    <p>© {new Date().getFullYear()} Deulli. All Rights Reserved.</p>
  </footer>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-bg);
    padding-block: 2rem 1.25rem;
  }

  /* 목업 뒤에 옅은 브랜드 블루를 한 겹. 흰 면이 밋밋해지지 않을 만큼만 쓴다. */
  .glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        38rem 32rem at 78% 42%,
        rgba(1, 80, 229, 0.11),
        transparent 66%
      ),
      radial-gradient(
        30rem 24rem at 6% 4%,
        rgba(251, 240, 230, 0.75),
        transparent 62%
      );
  }

  .grid {
    position: relative;
    flex: 1;
    display: grid;
    align-content: center;
    gap: 2.5rem;
  }

  /* ── 카피 ─────────────────────────────────────────────── */
  .copy {
    max-width: 34rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }
  .appicon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
  }
  .wordmark {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-neutral-900);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    padding: 0.32rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-brand-strong);
  }
  .badge-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    animation: badge-pulse 2.4s var(--ease-out-soft) infinite;
  }
  @keyframes badge-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-dot {
      animation: none;
    }
  }

  h1 {
    margin: 0.9rem 0 0;
    font-size: var(--text-display);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--color-neutral-900);
  }
  .brandword {
    display: block;
    margin-top: 0.08em;
    /* 슬로건을 받는 브랜드명이라 한 단계 크고 브랜드 블루다 */
    font-size: 1.3em;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-brand);
  }

  .lead {
    margin: 1rem 0 0;
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .form {
    max-width: 27rem;
    margin-top: 1.75rem;
  }

  /* ── 목업 ─────────────────────────────────────────────── */
  .shot-inner {
    position: relative;
    width: 100%;
    max-width: 15rem;
    margin-inline: auto;
  }
  .shot-inner :global(.mockup) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── 푸터 ─────────────────────────────────────────────── */
  .foot {
    position: relative;
    margin-top: 2rem;
    font-size: 0.75rem;
    color: var(--color-fg-faint);
  }
  .foot p {
    margin: 0;
  }

  /* ── 640px 이상 (아직 1단) ────────────────────────────── */
  @media (min-width: 640px) {
    .shot-inner {
      max-width: 18.75rem;
    }
  }

  /* ── 2단 전환 ─────────────────────────────────────────── */
  /* dionomy는 1024px에서 갈랐는데, 그 사이 폭(태블릿 세로)에서 카피는 왼쪽에
     몰리고 오른쪽이 통째로 비어 버린다. 여기서는 768px부터 가른다. */
  @media (min-width: 768px) {
    .hero {
      padding-block: 2.5rem 1.5rem;
    }
    .grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: 2.5rem;
    }
    .appicon {
      width: 2.25rem;
      height: 2.25rem;
    }
    .wordmark {
      font-size: 1.2rem;
    }
    .shot-inner {
      max-width: 17rem;
      margin-inline: auto 0;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      gap: 3.5rem;
    }
    .shot-inner {
      max-width: 23.75rem;
    }
  }
</style>
