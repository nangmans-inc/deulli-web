---
import { Image } from "astro:assets";
import SignupForm from "./SignupForm.astro";
import Multiline from "./ui/Multiline.astro";
import { prelaunch } from "../data/prelaunch";
import { site } from "../data/site";
import appPlayer from "../assets/app-player.png";
import mascot from "../assets/mascot.png";
---

{
  /* 좌우 분할. 색은 목업 뒤에만 두고 카피 쪽은 비운다 — 한 색으로 화면 전체를 덮으면
    슬로건이 배경과 싸우고, 폼도 색면 위에서 읽기 나빠진다. */
}
<section class="hero" data-ga-section="prelaunch">
  <div class="pane-copy">
    <div class="stack">
      <header class="brand reveal">
        <Image
          class="mascot"
          src={mascot}
          alt=""
          widths={[64, 128, 192]}
          sizes="(min-width: 1024px) 64px, 52px"
          loading="eager"
        />
        <span class="wordmark">{site.nameKo}</span>
      </header>

      <div class="copy">
        <p class="badge reveal" style="--reveal-delay: 60ms;">
          <span class="badge-dot" aria-hidden="true"></span>
          {prelaunch.badge}
        </p>

        <h1 class="reveal" style="--reveal-delay: 100ms;">
          <Multiline text={prelaunch.heading} />
          <span class="brandword">{prelaunch.headingBrand}</span>
        </h1>

        <p class="lead reveal" style="--reveal-delay: 140ms;">
          {prelaunch.lead}
        </p>

        <div class="form reveal" style="--reveal-delay: 180ms;">
          <SignupForm />
        </div>
      </div>
    </div>
  </div>

  <div class="pane-visual" aria-hidden="true">
    <div class="phone">
      <Image
        src={appPlayer}
        alt=""
        widths={[300, 460, 680, 906]}
        sizes="(min-width: 1024px) 344px, 260px"
        loading="eager"
      />
    </div>
  </div>

  <footer class="foot reveal" style="--reveal-delay: 240ms;">
    <p>© {new Date().getFullYear()} Deulli. All Rights Reserved.</p>
  </footer>
</section>

<style>
  /* 모바일은 카피 → 목업 → 저작권 순으로 쌓고, 데스크톱에서는 저작권이
     왼쪽 칸 바닥으로 들어간다. 목업 블록 위에 저작권이 오면 순서가 어색하다. */
  .hero {
    display: grid;
    min-height: 100svh;
    grid-template-areas:
      "copy"
      "visual"
      "foot";
    grid-template-rows: 1fr auto auto;
  }
  .pane-copy {
    grid-area: copy;
  }
  .pane-visual {
    grid-area: visual;
  }
  .foot {
    grid-area: foot;
  }

  /* ── 왼쪽: 카피 ───────────────────────────────────────── */
  .pane-copy {
    position: relative;
    display: flex;
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      var(--color-neutral-50) 100%
    );
    padding: 1.75rem 1.25rem 2.25rem;
  }

  .stack {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 34rem;
    margin-inline: auto;
  }

  /* 마스코트를 혼자 띄워 두지 않고 워드마크와 묶어 브랜드 줄로 세운다 */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .mascot {
    width: 3.25rem;
    height: 3.25rem;
    filter: drop-shadow(0 10px 20px rgba(8, 33, 66, 0.2));
  }
  .wordmark {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-neutral-900);
  }

  /* 카피 블록이 남는 세로를 먹고 그 안에서 가운데 정렬된다 */
  .copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 2.25rem;
  }

  .badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    padding: 0.32rem 0.8rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-brand-strong);
  }
  .badge-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    animation: badge-pulse 2.4s var(--ease-out-soft) infinite;
  }
  @keyframes badge-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-dot {
      animation: none;
    }
  }

  h1 {
    margin: 0.9rem 0 0;
    font-size: var(--text-display);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--color-neutral-900);
  }
  .brandword {
    display: block;
    margin-top: 0.1em;
    /* 슬로건을 받는 브랜드명이라 한 단계 크고 브랜드 블루다 */
    font-size: 1.32em;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--color-brand);
  }

  .lead {
    margin: 1rem 0 0;
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .form {
    margin-top: 1.75rem;
  }

  .foot {
    display: flex;
    padding: 1.25rem;
    background: var(--color-neutral-50);
    font-size: 0.75rem;
    color: var(--color-fg-faint);
  }
  .foot p {
    width: 100%;
    max-width: 34rem;
    margin: 0;
    margin-inline: auto;
  }

  /* ── 오른쪽: 목업 ─────────────────────────────────────── */
  .pane-visual {
    position: relative;
    overflow: hidden;
    min-height: 32rem;
    background: var(--color-brand);
  }
  /* 아래로 갈수록 짙어져 목업이 배경에서 뜬다 */
  .pane-visual::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        34rem 26rem at 22% 8%,
        rgba(255, 255, 255, 0.24),
        transparent 62%
      ),
      linear-gradient(180deg, transparent 35%, rgba(7, 26, 67, 0.55) 100%);
  }

  /* 아래를 화면 밖으로 흘려보낸다. 페이드로 지우는 것보다 잘린 편이 의도적으로 읽힌다 */
  .phone {
    position: absolute;
    bottom: -3.5rem;
    left: 50%;
    width: 16.25rem;
    transform: translateX(-50%) rotate(-5deg);
  }
  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.75rem;
    box-shadow: 0 50px 90px -30px rgba(4, 12, 34, 0.7);
  }

  /* ── 데스크톱 ─────────────────────────────────────────── */
  @media (min-width: 1024px) {
    .hero {
      grid-template-areas:
        "copy visual"
        "foot visual";
      grid-template-columns: minmax(0, 1fr) minmax(0, 42%);
      grid-template-rows: 1fr auto;
    }
    .foot {
      padding: 0 clamp(2rem, 4vw, 4rem) 2.5rem;
      background: var(--color-neutral-50);
    }
    .foot p {
      max-width: 30rem;
    }
    .pane-copy {
      padding: 2.5rem clamp(2rem, 4vw, 4rem);
    }
    .stack {
      max-width: 30rem;
    }
    .mascot {
      width: 4rem;
      height: 4rem;
    }
    .wordmark {
      font-size: 1.35rem;
    }
    .copy {
      padding-block: 2.5rem;
    }
    .phone {
      bottom: -5rem;
      width: 21.5rem;
      transform: translateX(-50%) rotate(-6deg);
    }
  }

  @media (min-width: 1440px) {
    .stack,
    .foot p {
      max-width: 32rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone {
      transform: translateX(-50%);
    }
  }
</style>
