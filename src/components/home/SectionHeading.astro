---
interface Props {
  id: string;
  title: string;
  lead?: string;
}
const { id, title, lead } = Astro.props;
---

<div class="section-heading">
  <h2 id={id}>{title}</h2>
  {lead && <p>{lead}</p>}
</div>

<style>
  .section-heading {
    max-width: 44rem;
    margin-bottom: 2.5rem;
  }
  h2 {
    font-size: var(--text-h2);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  p {
    margin-top: 1rem;
    color: var(--color-fg-muted);
    font-size: var(--text-lead);
    line-height: 1.8;
  }
</style>
