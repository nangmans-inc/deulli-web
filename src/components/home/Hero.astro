---
import { Image } from "astro:assets";
import HeroBackdrop from "./HeroBackdrop.astro";
import StoreLinks from "../StoreLinks.astro";
import { site } from "../../data/site";
import heroMockup from "../../assets/hero-mockup.png";
---

<section class="hero" data-ga-section="home">
  <HeroBackdrop />
  <div class="container-content grid">
    <div class="copy">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1>
        듣다 보면 <br class="wide-only" />들리니까,
        <span class="brandword">{site.nameKo}</span>
      </h1>
      <p class="lead">{site.hero.lead}</p>
      <div class="downloads">
        <StoreLinks />
      </div>
    </div>

    <div class="shot">
      <Image
        class="mockup"
        src={heroMockup}
        alt="들리 앱 재생 화면: 영어 문장과 한국어 번역, 재생 컨트롤"
        widths={[300, 450, 600, 900]}
        sizes="(min-width: 1024px) 380px, (min-width: 700px) 272px, min(62vw, 240px)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  /* 첫 화면을 채우되 상한을 둔다. svh에만 묶으면 세로로 긴 뷰포트(검색 렌더러 포함)에서
     히어로가 끝없이 늘어나 아래 본문이 밀려난다. */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    min-height: min(calc(100svh - var(--header-height)), 44rem);
  }

  .grid {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1.5rem;
    padding-block: 1.5rem 2.5rem;
  }

  .copy {
    width: 100%;
    max-width: 34rem;
  }

  .eyebrow {
    margin-bottom: 0.75rem;
    color: var(--color-brand);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  h1 {
    font-size: clamp(2rem, 9vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--color-neutral-900);
  }
  .wide-only {
    display: none;
  }
  /* 슬로건을 받는 브랜드명이라 브랜드 블루다 */
  .brandword {
    color: var(--color-brand);
  }

  .lead {
    margin-top: 0.75rem;
    font-size: var(--text-lead);
    font-weight: 500;
    color: var(--color-fg-muted);
  }

  .downloads {
    margin-top: 1.5rem;
  }
  .downloads :global(.store-links) {
    gap: 0.5rem;
  }

  .shot {
    width: min(62vw, 15rem);
  }
  .shot :global(.mockup) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── 2단 전환 ─────────────────────────────────────────── */
  /* 700px부터 가른다 — 그 아래는 한 손 폭이라 1단이 자연스럽고, 위로는 목업이 오른쪽을 채운다. */
  @media (min-width: 700px) {
    .hero {
      min-height: min(calc(100svh - var(--header-height)), 46rem);
    }
    .grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      justify-items: stretch;
      gap: 2.5rem;
      padding-block: 2rem 3rem;
    }
    h1 {
      font-size: var(--text-display);
      line-height: 1.08;
    }
    .wide-only {
      display: inline;
    }
    .brandword {
      display: block;
      margin-top: 0.08em;
      font-size: 1.3em;
      line-height: 1;
      letter-spacing: -0.05em;
    }
    .lead {
      margin-top: 1rem;
    }
    .downloads {
      margin-top: 1.75rem;
    }
    .downloads :global(.store-links) {
      gap: 1rem;
    }
    .shot {
      width: 100%;
      max-width: 17rem;
      margin-inline: auto 0;
    }
  }

  @media (min-width: 1024px) {
    .grid {
      gap: 3.5rem;
    }
    /* 목업 비율이 1:1.67이라 높이를 뷰포트에 묶어 두면 폭이 알아서 줄어든다. */
    .shot {
      max-width: min(23.75rem, 45vh);
    }
  }
</style>
