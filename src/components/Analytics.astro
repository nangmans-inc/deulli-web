---
// Google Analytics 4 — 프로덕션 빌드 + 측정 ID가 있을 때만 로드.
// (dev 서버에서는 로드되지 않아 데이터가 오염되지 않음)
//
// defer: gtag.js 내려받기를 window load 이후로 미룬다. 이벤트는 dataLayer에 쌓였다가
// 스크립트가 오면 전송되므로 빠지지 않는다. 첫 화면 이미지(LCP)와 대역폭을 다투지 않게 한다.
// 공유 페이지는 load 직후 스토어로 이동하므로 미루지 않는다.
interface Props {
  defer?: boolean;
}
const { defer = false } = Astro.props;
const gaId = import.meta.env.PUBLIC_GA_ID;
const enabled = import.meta.env.PROD && !!gaId;

const initScript = `
(function () {
  function load() {
    var s = document.createElement("script");
    s.async = true;
    s.src = "https://www.googletagmanager.com/gtag/js?id=${gaId}";
    document.head.appendChild(s);
  }
  if (!${defer} || document.readyState === "complete") load();
  else window.addEventListener("load", function () { setTimeout(load, 0); });
})();
window.dataLayer = window.dataLayer || [];
function gtag(){ dataLayer.push(arguments); }
gtag("js", new Date());
gtag("config", "${gaId}");

// CTA 클릭 위임 트래킹: [data-ga-event] 요소 클릭 시 이벤트 발사
document.addEventListener("click", function (e) {
  var t = e.target;
  var el = t instanceof Element ? t.closest("[data-ga-event]") : null;
  if (!el) return;
  var label = el.getAttribute("data-ga-label");
  gtag("event", el.getAttribute("data-ga-event"), label ? { label: label } : {});
});

// 섹션별 노출 추적: [data-ga-section]이 화면 중앙 밴드에 들어오면 section_view 1회
function initSectionTracking() {
  var sections = document.querySelectorAll("[data-ga-section]");
  if (!sections.length || !("IntersectionObserver" in window)) return;
  var io = new IntersectionObserver(
    function (entries, obs) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        gtag("event", "section_view", {
          section: entry.target.getAttribute("data-ga-section"),
        });
        obs.unobserve(entry.target);
      });
    },
    // 뷰포트 위/아래 35%를 제외한 중앙 30% 밴드에 닿으면 발사 (섹션 높이 무관)
    { rootMargin: "-35% 0px -35% 0px", threshold: 0 },
  );
  sections.forEach(function (s) {
    io.observe(s);
  });
}
if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", initSectionTracking);
} else {
  initSectionTracking();
}
`;
---

{enabled && <script is:inline set:html={initScript} />}
