---
interface Props {
  fallback?: boolean;
  /** fbevents.js 내려받기를 window load 이후로 미룬다. 호출은 큐에 쌓였다가 전송된다. */
  defer?: boolean;
}

const { fallback = false, defer = false } = Astro.props;
const pixelId = "1364197462562357";
const enabled = import.meta.env.PROD;
const pixelScript = `
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];
  function l(){t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}
  if(!${defer}||b.readyState==='complete')l();
  else f.addEventListener('load',function(){setTimeout(l,0)});
  }(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');
  fbq('init', '${pixelId}');
  fbq('track', 'PageView');
`;
const fallbackUrl = `https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`;
---

{
  enabled &&
    (fallback ? (
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          src={fallbackUrl}
          alt=""
        />
      </noscript>
    ) : (
      <script is:inline set:html={pixelScript} />
    ))
}
