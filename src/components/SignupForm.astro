---
import CheckIcon from "./ui/CheckIcon.astro";
import { prelaunch } from "../data/prelaunch";
import { site } from "../data/site";
---

{
  /* 이 폼은 아이보리 면 위에 놓이는 것을 전제로 색을 잡았다.
    브랜드 블루 면에 올리려면 아래 스타일의 색부터 다시 봐야 한다. */
}
<div class="signup">
  <form id="signup-form" novalidate>
    <div class="field">
      <label for="f-phone">{prelaunch.formLabel}</label>
      <div class="row">
        <input
          id="f-phone"
          name="phone"
          type="tel"
          inputmode="numeric"
          autocomplete="tel-national"
          maxlength="13"
          required
          placeholder={prelaunch.formPlaceholder}
        />
        <button type="submit" class="submit-btn">{prelaunch.submitLabel}</button
        >
      </div>
      <p class="field-error" data-phone-error hidden>
        휴대폰 번호를 정확히 입력해 주세요.
      </p>
    </div>

    {/* 스팸 봇 유인용. 사람 눈에도 스크린리더에도 노출되지 않는다. */}
    <div class="honeypot" aria-hidden="true">
      <label for="f-company">회사명</label>
      <input
        id="f-company"
        name="company"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="consent-field">
      <label class="consent">
        <input id="f-consent" name="consent" type="checkbox" required />
        <span>
          출시 알림 발송을 위한 <strong>개인정보 수집·이용</strong>에
          동의합니다. 수집 항목은 전화번호이며, 발송 후 파기합니다. (<a
            href={site.policy.privacy}
            target="_blank"
            rel="noopener">개인정보 처리방침</a
          >)
        </span>
      </label>
      <p class="field-error" data-consent-error hidden>
        개인정보 수집·이용에 동의해 주세요.
      </p>
    </div>
  </form>

  <!-- success state (hidden until submit) -->
  <div id="signup-success" hidden class="done">
    <div class="done-mark">
      <CheckIcon />
    </div>
    <div>
      <p class="done-title">{prelaunch.successHeading}</p>
      <p class="done-body">{prelaunch.successBody}</p>
    </div>
  </div>
</div>

<!-- toast -->
<div id="signup-toast" role="status" aria-live="polite" class="toast"></div>

<script>
  import { prelaunch } from "../data/prelaunch";

  const form = document.getElementById("signup-form") as HTMLFormElement | null;
  const success = document.getElementById("signup-success");
  const toast = document.getElementById("signup-toast");
  const phoneInput = document.getElementById(
    "f-phone",
  ) as HTMLInputElement | null;
  const consentInput = document.getElementById(
    "f-consent",
  ) as HTMLInputElement | null;
  const honeypot = document.getElementById(
    "f-company",
  ) as HTMLInputElement | null;
  const phoneError = document.querySelector<HTMLElement>("[data-phone-error]");
  const consentError = document.querySelector<HTMLElement>(
    "[data-consent-error]",
  );
  const consentField = consentInput?.closest<HTMLElement>(".consent-field");
  const submitBtn = form?.querySelector<HTMLButtonElement>(".submit-btn");

  const FORM_ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT;

  // ── 중복 신청 방지: 이미 신청했으면 폼 대신 완료 화면 ──────────
  const APPLIED_KEY = "deulli:applied";

  function hasApplied() {
    try {
      return localStorage.getItem(APPLIED_KEY) === "true";
    } catch {
      return false;
    }
  }

  function markApplied() {
    try {
      localStorage.setItem(APPLIED_KEY, "true");
    } catch {
      /* localStorage 사용 불가(시크릿 모드 등) 시 무시 */
    }
  }

  function showApplied() {
    if (form) form.hidden = true;
    if (success) success.hidden = false;
  }

  if (hasApplied()) showApplied();

  // ── 전화번호 입력 보조 ────────────────────────────────────
  // 010-0000-0000(3-4-4)로만 자동 하이픈. 010 외 구형 번호(011 등)도
  // 검증은 통과시키되 포맷은 강제하지 않는다.
  function formatPhone(raw: string) {
    const d = raw.replace(/\D/g, "").slice(0, 11);
    if (d.length < 4) return d;
    if (d.length < 8) return `${d.slice(0, 3)}-${d.slice(3)}`;
    return `${d.slice(0, 3)}-${d.slice(3, 7)}-${d.slice(7)}`;
  }

  function isValidPhone(v: string) {
    return /^01[016789]\d{7,8}$/.test(v.replace(/\D/g, ""));
  }

  phoneInput?.addEventListener("input", () => {
    const el = phoneInput;
    const atEnd = el.selectionStart === el.value.length;
    const formatted = formatPhone(el.value);
    if (formatted !== el.value) {
      el.value = formatted;
      // 커서가 끝에 있던 경우에만 끝으로 되돌린다(중간 수정 시 튀지 않게).
      if (atEnd) el.setSelectionRange(formatted.length, formatted.length);
    }
    if (phoneError && !phoneError.hidden && isValidPhone(el.value)) {
      phoneError.hidden = true;
      el.classList.remove("has-error");
    }
  });

  // GA 전환 이벤트 — gtag 미로드 시 안전하게 무시
  function track(name: string, params: Record<string, unknown> = {}) {
    (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.(
      "event",
      name,
      params,
    );
  }

  let toastTimer = 0;
  function showToast(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add("is-visible");
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(
      () => toast.classList.remove("is-visible"),
      3200,
    );
  }

  // 첫 입력 시 퍼널 이벤트 1회
  let formStarted = false;
  form?.addEventListener("input", () => {
    if (formStarted) return;
    formStarted = true;
    track("signup_form_start");
  });

  function onSuccess() {
    track("generate_lead", { method: "prelaunch_waitlist" });
    markApplied();
    showApplied();
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    track("signup_submit"); // 제출 시도(검증 통과 여부 무관)

    const phoneValid = !!phoneInput && isValidPhone(phoneInput.value);
    if (phoneError) phoneError.hidden = phoneValid;
    phoneInput?.classList.toggle("has-error", !phoneValid);

    const consentValid = !!consentInput?.checked;
    if (consentError) consentError.hidden = consentValid;
    consentField?.classList.toggle("has-error", !consentValid);

    if (!phoneValid || !consentValid) {
      const reasons: string[] = [];
      if (!phoneValid) reasons.push("phone");
      if (!consentValid) reasons.push("consent");
      track("signup_invalid", { reason: reasons.join(",") });
      (phoneValid ? consentInput : phoneInput)?.focus();
      return;
    }

    // 허니팟이 채워졌으면 봇이다. 조용히 성공한 척하고 전송하지 않는다.
    if (honeypot?.value) {
      onSuccess();
      return;
    }

    const payload = {
      // Apps Script가 이 값으로 시트 탭을 고른다(같은 웹 앱을 여러 랜딩이 공유).
      form: "deulli",
      phone: phoneInput!.value,
      consent: true,
      // 유입 분석용 — 개인정보가 아니며 시트에 그대로 기록된다.
      referrer: document.referrer || "",
      landing: location.href,
    };

    // 백엔드 미설정(로컬 개발 등) → 콘솔 스텁으로 성공 처리
    if (!FORM_ENDPOINT) {
      console.warn(
        "[deulli] PUBLIC_FORM_ENDPOINT 미설정 — 제출 데이터:",
        payload,
      );
      onSuccess();
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = prelaunch.submitPendingLabel;
    }

    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: "POST",
        // text/plain → CORS preflight 회피(simple request), 정상 응답 수신
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(`status ${res.status}`);
      onSuccess();
    } catch (err) {
      track("signup_error", { message: String(err) });
      console.error("[deulli] 사전신청 전송 실패:", err);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = prelaunch.submitLabel;
      }
      showToast(prelaunch.errorToast);
    }
  });
</script>

<style>
  /* 화면 밖으로 밀어내되 display:none은 피한다 — 봇은 보이는 필드만 채우지 않는다 */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-fg-muted);
  }

  .row {
    display: grid;
    gap: 0.5rem;
  }
  @media (min-width: 480px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .field input {
    width: 100%;
    border-radius: 0.85rem;
    border: 1px solid var(--color-border-strong);
    background: #ffffff;
    padding: 0.9rem 1rem;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-fg);
    font-variant-numeric: tabular-nums;
    transition:
      border-color 0.18s,
      box-shadow 0.18s;
    appearance: none;
  }
  .field input::placeholder {
    color: var(--color-fg-faint);
    font-weight: 400;
    letter-spacing: normal;
  }
  .field input:focus {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-brand) 18%, transparent);
  }
  .field input.has-error {
    border-color: var(--color-signal-risk);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-signal-risk) 16%, transparent);
  }

  .field-error {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-danger-700);
  }

  .submit-btn {
    border-radius: 0.85rem;
    background: var(--color-brand);
    padding: 0.9rem 1.35rem;
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
    color: var(--color-on-brand);
    box-shadow: 0 10px 24px -14px
      color-mix(in srgb, var(--color-brand) 95%, transparent);
    transition:
      background-color 0.18s,
      transform 0.18s;
  }
  .submit-btn:hover:not(:disabled) {
    background: var(--color-brand-strong);
    transform: translateY(-1px);
  }
  .submit-btn:active:not(:disabled) {
    transform: translateY(0);
  }
  .submit-btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  /* ── 동의 ─────────────────────────────────────────────── */
  .consent-field {
    margin-top: 0.9rem;
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    cursor: pointer;
  }
  .consent input {
    margin-top: 0.15rem;
    width: 1.05rem;
    height: 1.05rem;
    flex-shrink: 0;
    accent-color: var(--color-brand);
    cursor: pointer;
  }
  .consent span {
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-fg-muted);
  }
  .consent strong {
    color: var(--color-fg);
    font-weight: 600;
  }
  .consent a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .consent-field.has-error .consent input {
    outline: 2px solid var(--color-signal-risk);
    outline-offset: 2px;
    border-radius: 0.2rem;
  }

  /* ── 완료 ─────────────────────────────────────────────── */
  .done {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background: #ffffff;
    padding: 1.1rem 1.25rem;
    box-shadow: 0 18px 40px -28px rgba(8, 33, 66, 0.45);
  }
  .done-mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
  }
  /* 자식 컴포넌트가 그리는 <svg>라 스코프 셀렉터가 닿지 않는다.
     부모(.done-mark)로 범위를 잡고 :global로 내려간다. */
  .done-mark :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--color-brand);
  }
  .done-title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--color-fg);
  }
  .done-body {
    margin: 0.2rem 0 0;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-fg-muted);
  }

  /* ── 토스트 ───────────────────────────────────────────── */
  .toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    z-index: 50;
    max-width: min(24rem, calc(100vw - 2.5rem));
    transform: translate(-50%, 1rem);
    border-radius: var(--radius-pill);
    background: var(--color-neutral-950);
    padding: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
    color: #ffffff;
    opacity: 0;
    pointer-events: none;
    box-shadow: 0 18px 40px -18px rgba(4, 12, 34, 0.6);
    transition:
      opacity 0.3s,
      transform 0.3s;
  }
  .toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>
