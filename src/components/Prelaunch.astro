---
import SignupForm from "./SignupForm.astro";
import CheckIcon from "./ui/CheckIcon.astro";
import Multiline from "./ui/Multiline.astro";
import { prelaunch } from "../data/prelaunch";
import { site } from "../data/site";
---

<section
  class="stage relative grid min-h-[100svh] place-items-center overflow-hidden px-5 py-8"
  data-ga-section="prelaunch"
>
  <!-- decorative glow — 로고의 파랑/크림을 배경으로 옮겨 놓은 것 -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-40 left-1/2 size-[38rem] -translate-x-1/2 rounded-full opacity-55 blur-3xl"
      style="background: radial-gradient(circle, rgba(1,80,229,0.20), transparent 68%);"
    >
    </div>
    <div
      class="absolute -bottom-48 -left-32 size-[34rem] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, rgba(251,240,230,0.95), transparent 70%);"
    >
    </div>
    <div
      class="absolute -right-40 -bottom-24 size-[30rem] rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(circle, rgba(8,33,66,0.16), transparent 70%);"
    >
    </div>
  </div>

  {
    /* min-w-0 — 한글은 word-break:keep-all이라 min-content 폭이 크다. 이게 없으면
      그리드 트랙이 카드의 min-content만큼 벌어져 좁은 화면에서 카드가 잘린다. */
  }
  <div class="relative w-full max-w-[27rem] min-w-0">
    <div
      class="reveal rounded-[1.75rem] border border-white/70 bg-bg/85 p-7 shadow-[0_1px_2px_rgba(4,18,37,0.04),0_28px_60px_-28px_rgba(4,18,37,0.28)] backdrop-blur-xl sm:p-8"
    >
      <!-- brand -->
      <img
        src="/logo.svg"
        alt="들리 로고"
        width="56"
        height="56"
        class="size-14 rounded-[1.05rem] shadow-[0_8px_20px_-10px_rgba(1,80,229,0.7)]"
      />

      <p class="badge mt-5">
        <span class="badge-dot" aria-hidden="true"></span>
        {prelaunch.badge}
      </p>

      <h1
        class="mt-3.5 text-[1.95rem] leading-[1.24] font-bold tracking-[-0.03em] text-balance text-fg"
      >
        <Multiline text={prelaunch.heading} />
      </h1>

      <p class="mt-3.5 text-[0.96rem] leading-relaxed text-fg-muted">
        <Multiline text={prelaunch.lead} />
      </p>

      <ul class="mt-4 space-y-2.5 border-t border-border pt-4">
        {
          prelaunch.points.map((point) => (
            <li class="flex items-start gap-2.5 text-[0.88rem] text-fg-muted">
              <CheckIcon class="mt-0.5 size-4 shrink-0 text-brand" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>

      <div class="mt-6">
        <SignupForm />
      </div>
    </div>

    <!-- footer -->
    <footer
      class="reveal mt-5 text-center text-[0.76rem] text-fg-faint"
      style="--reveal-delay: 120ms;"
    >
      <nav
        class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1"
        aria-label="사이트 정보"
      >
        <a
          href={`mailto:${site.email}`}
          class="transition-colors hover:text-brand"
          data-ga-event="mailto_click"
          data-ga-label="footer">문의</a
        >
        <span aria-hidden="true">·</span>
        <a
          href={site.policy.privacy}
          target="_blank"
          rel="noopener"
          class="transition-colors hover:text-brand">개인정보 처리방침</a
        >
        <span aria-hidden="true">·</span>
        <a
          href={site.policy.terms}
          target="_blank"
          rel="noopener"
          class="transition-colors hover:text-brand">이용약관</a
        >
      </nav>
      <p class="mt-2">
        © {new Date().getFullYear()}
        {site.nameKo} ({site.name}) · {site.legalName}
      </p>
    </footer>
  </div>
</section>

<style>
  .stage {
    background:
      linear-gradient(180deg, var(--color-cream-50) 0%, #ffffff 55%),
      var(--color-bg);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand-soft);
    padding: 0.3rem 0.75rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-brand-strong);
  }
  .badge-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-brand);
    animation: badge-pulse 2.4s var(--ease-out-soft) infinite;
  }
  @keyframes badge-pulse {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 0
        color-mix(in srgb, var(--color-brand) 45%, transparent);
    }
    50% {
      opacity: 0.75;
      box-shadow: 0 0 0 0.28rem
        color-mix(in srgb, var(--color-brand) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge-dot {
      animation: none;
    }
  }
</style>
