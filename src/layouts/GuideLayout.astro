---
import BaseLayout from "./BaseLayout.astro";
import StoreLinks from "../components/StoreLinks.astro";
import { site } from "../data/site";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    relatedPath: string;
    relatedTitle: string;
    lang?: "ko" | "en";
    alternates?: { lang: "ko" | "en"; path: string }[];
  };
}
const { frontmatter } = Astro.props;
const lang = frontmatter.lang ?? "ko";
const english = lang === "en";
---

<BaseLayout
  title={`${frontmatter.title} | 들리 deulli`}
  description={frontmatter.description}
  lang={lang}
  alternates={frontmatter.alternates}
  imageAlt={english
    ? "Deulli: learn English with podcasts, transcripts and Korean translations"
    : undefined}
>
  <div class="reading-page">
    <header>
      <a href="/" aria-label={english ? "Deulli home (Korean)" : "들리 홈"}>
        <img src="/logo.svg" alt="" width="40" height="40" />
        <span>{english ? "Deulli" : "들리"}</span>
      </a>
    </header>
    <main id="main-content">
      <article>
        <h1>{frontmatter.title}</h1>
        <slot />
      </article>
      <aside aria-label={english ? "Related reading" : "함께 읽기"}>
        <p>{english ? "Related reading" : "함께 읽기"}</p>
        <a href={frontmatter.relatedPath}>{frontmatter.relatedTitle}</a>
      </aside>
      <section class="download" aria-labelledby="download-title">
        <h2 id="download-title">
          {
            english
              ? "Listen and study with Deulli."
              : "들리에서 팟캐스트로 공부해보세요."
          }
        </h2>
        <p>
          {
            english
              ? "Check the store listing and the app for device requirements, current pricing and availability. The app is designed for Korean-speaking English learners."
              : "기기별 지원 버전과 최신 이용 조건은 스토어와 앱에서 확인해주세요."
          }
        </p>
        <StoreLinks lang={lang} />
      </section>
    </main>
    <footer>
      <a href="/">{english ? "Deulli home (Korean)" : "들리 홈"}</a>
      <a href={site.policy.support}
        >{english ? "Support (Korean)" : "고객지원"}</a
      >
      <a href={site.policy.privacy}
        >{english ? "Privacy (Korean)" : "개인정보 처리방침"}</a
      >
      <a href={site.policy.terms}>{english ? "Terms (Korean)" : "이용약관"}</a>
    </footer>
  </div>
</BaseLayout>

<style>
  /* 기존 들리 서체·네이비 본문·블루 링크로 긴 스크립트처럼 이어 읽는다. */
  .reading-page {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }
  header {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  header a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    gap: 0.75rem;
    color: var(--color-fg);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }
  header img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  article {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }
  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  article :global(h2),
  .download h2 {
    margin-top: 2.75rem;
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.4;
  }
  article :global(p),
  article :global(li),
  .download p {
    color: var(--color-fg-muted);
    font-size: var(--text-lead);
    line-height: 1.9;
  }
  article :global(p) {
    margin-top: 1.25rem;
  }
  article :global(ul),
  article :global(ol) {
    margin-top: 1.25rem;
    padding-left: 1.5rem;
  }
  article :global(li) {
    margin-top: 0.75rem;
  }
  article :global(ul) {
    list-style: disc;
  }
  article :global(ol) {
    list-style: decimal;
  }
  article :global(table) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin-top: 1.5rem;
    color: var(--color-fg-muted);
    line-height: 1.8;
  }
  article :global(th),
  article :global(td) {
    padding: 0.875rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }
  article :global(th:first-child),
  article :global(td:first-child) {
    width: 32%;
  }
  a,
  article :global(a) {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  aside {
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--color-border);
    line-height: 1.8;
  }
  aside p {
    color: var(--color-fg-muted);
    margin-bottom: 0.5rem;
  }
  .download {
    padding-bottom: 3rem;
  }
  .download p {
    margin-block: 1rem 1.5rem;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--color-border);
  }
  footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
