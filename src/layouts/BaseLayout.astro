---
/**
 * 문서 껍데기: <head>의 메타·OG·구조화 데이터와 측정 스크립트만 맡는다.
 * 헤더·푸터가 있는 일반 페이지는 PageLayout을 쓴다. 공유 페이지처럼 자체 화면 구성이
 * 필요한 경우에만 이 레이아웃을 직접 쓴다.
 */
import "../styles/global.css";
import { site } from "../data/site";
import { isoDate, jsonLdGraph } from "../lib/seo";
import Analytics from "../components/Analytics.astro";
import MetaPixel from "../components/MetaPixel.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalPath?: string;
  noindex?: boolean;
  lang?: "ko" | "en";
  /** 같은 문서의 언어별 주소. 첫 항목이 x-default가 된다. */
  alternates?: { lang: "ko" | "en"; path: string }[];
  ogType?: "website" | "article";
  publishedAt?: Date;
  updatedAt?: Date;
  /** 이 페이지의 schema.org 노드. lib/seo.ts의 빌더로 만든다. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = site.defaultTitle,
  description = site.description,
  image,
  imageAlt = site.ogImageAlt,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  lang = "ko",
  alternates = [],
  ogType = "website",
  publishedAt,
  updatedAt,
  jsonLd = [],
} = Astro.props;

const origin = Astro.site ?? site.url;
const canonical = new URL(canonicalPath, origin).href;
const ogImage = new URL(image ?? site.ogImage, origin).href;
const alternateLinks = alternates.map((alternate) => ({
  lang: alternate.lang,
  href: new URL(alternate.path, origin).href,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternateLinks.map((alternate) => (
        <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
      ))
    }
    {
      alternateLinks[0] && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={alternateLinks[0].href}
        />
      )
    }
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Self-hosted Pretendard (variable · unicode-range dynamic subset) -->
    <link
      rel="stylesheet"
      href="/fonts/pretendard/pretendardvariable-dynamic-subset.css"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.nameKo} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "ko_KR"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    {
      ogType === "article" && publishedAt && (
        <meta
          property="article:published_time"
          content={isoDate(publishedAt)}
        />
      )
    }
    {
      ogType === "article" && updatedAt && (
        <meta property="article:modified_time" content={isoDate(updatedAt)} />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {
      jsonLd.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          set:html={jsonLdGraph(jsonLd)}
        />
      )
    }

    <Analytics />
    <MetaPixel />
  </head>
  <body>
    <MetaPixel fallback />
    <slot />
  </body>
</html>
