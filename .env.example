# 복사해서 .env 로 쓰세요. PUBLIC_ 접두사 값은 빌드 시점에 클라이언트 번들로 인라인됩니다.

# GA4 측정 ID (예: G-XXXXXXXXXX). 비워 두면 GA를 로드하지 않습니다.
# 프로덕션 빌드에서만 로드되므로 dev 서버 트래픽은 집계되지 않습니다.
PUBLIC_GA_ID=

# 서버 전용 메타데이터 API. PUBLIC_ 접두사를 붙이지 않습니다.
# 로컬 mock은 http://127.0.0.1:포트 사용 가능. 운영은 HTTPS를 사용합니다.
API_BASE=https://api.deulli.nangmans.com
